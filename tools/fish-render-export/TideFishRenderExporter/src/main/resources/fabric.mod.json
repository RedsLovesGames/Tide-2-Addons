{
  "schemaVersion": 1,
  "id": "tide_fish_render_exporter",
  "version": "${version}",
  "name": "Tide Fish Runtime Exporter",
  "description": "Discovers Tide fish from the running modpack and exports source-authentic Tide Fish Display renders, provenance, and reports as a portable ZIP.",
  "authors": ["RedsLovesGames"],
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.redslovesgames.tidefishrender.TideFishRenderExporter",
      "com.redslovesgames.tidefishrender.RuntimeBundleAutoInitializer"
    ]
  },
  "depends": {
    "fabricloader": ">=0.18.4",
    "fabric-api": ">=0.116.15+1.21.1",
    "minecraft": "=1.21.1",
    "java": ">=21",
    "tide": "=2.1.1"
  },
  "suggests": {
    "tideborne": ">=1.3.57"
  }
}
